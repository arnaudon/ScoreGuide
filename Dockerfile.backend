# syntax=docker/dockerfile:1

# Note: the deploy builds through docker-compose v1 + `docker build` on Docker
# 20.10 without BuildKit (the legacy builder), so no `RUN --mount=type=cache`
# here; dependency layers are cached by ordering the COPYs instead.

FROM astral/uv:python3.15-trixie-slim AS builder

# Prevents Python from writing pyc files.
ENV PYTHONDONTWRITEBYTECODE=1

# Keeps Python from buffering stdout and stderr to avoid situations where
# the application crashes without emitting any logs due to buffering.
ENV PYTHONUNBUFFERED=1

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=1

# Copy from the cache instead of linking since it's a mounted volume
ENV UV_LINK_MODE=copy

# No package cache left behind in the layer (nothing reuses it between builds).
ENV UV_NO_CACHE=1

# Ensure installed tools can be executed out of the box
ENV UV_TOOL_BIN_DIR=/usr/local/bin

# Prod images skip the dev group (pytest & co). docker-compose.override.yaml
# sets INSTALL_DEV=true so the dev/CI image can run the test suite in place.
ARG INSTALL_DEV=false

WORKDIR /app

# Third-party dependencies first, from the lock and the manifests only: this
# (slowest) layer is reused until a pyproject.toml or uv.lock changes, not on
# every source change in backend/ or shared/.
COPY pyproject.toml uv.lock ./
COPY backend/pyproject.toml ./backend/
COPY shared/pyproject.toml ./shared/
RUN uv sync --locked --no-install-workspace --package app \
        $([ "$INSTALL_DEV" = "true" ] || echo --no-dev)

COPY shared/README.md ./shared/
COPY shared/shared ./shared/shared
COPY backend/README.md ./backend/
COPY backend/app ./backend/app
RUN uv sync --locked --package app \
        $([ "$INSTALL_DEV" = "true" ] || echo --no-dev)


FROM python:3.15-slim-trixie

WORKDIR /app

EXPOSE 8000

# Tesseract OCR reads piece/movement headings on scanned scores for the
# table of contents (app/toc.py). Language packs cover typical score titles.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        tesseract-ocr tesseract-ocr-deu tesseract-ocr-fra tesseract-ocr-ita \
    && rm -rf /var/lib/apt/lists/*

# Run as a non-root user. uid 1000 matches the default first user on the
# host so dev bind mounts (./backend, ./data) stay writable.
RUN useradd --create-home --uid 1000 app

COPY --from=builder --chown=app:app /app/.venv /app/.venv
COPY --from=builder --chown=app:app /app/backend /app/backend
COPY --from=builder --chown=app:app /app/shared /app/shared
# copy these for db migration
COPY --chown=app:app backend/migrations /app/backend/migrations
COPY --chown=app:app backend/alembic.ini /app/backend/alembic.ini

ENV PYTHONPATH=/app
ENV PATH="/app/.venv/bin:$PATH"

USER app

CMD uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --workers 1
