scoreguide.ch {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# SAMEORIGIN (not DENY): the PDF.js viewer embeds same-origin frames.
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy frontend:3000
}

gardenai.scoreguide.ch {
	# Developer docs: GardenAI's MkDocs site (docs_garden, nginx on :80).
	# Its nginx serves /docs/ itself, so the prefix is kept.
	redir /docs /docs/ 308
	handle /docs/* {
		reverse_proxy docs_garden:80
	}
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy backend_garden:8000
	}
	handle {
		reverse_proxy frontend_garden:3000
	}
}

:8000 {
	reverse_proxy backend:8000
}

:5050 {
	reverse_proxy pgadmin:80
}
