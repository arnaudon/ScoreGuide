# Allowlist: both images build from the repo root, and the prod checkout also
# holds data/, database dumps, .env and local caches (.mypy_cache, htmlcov,
# node_modules, .svelte-kit, build/...). The legacy builder used by the deploy
# sends the whole context to the daemon for each image, and anything copied
# by a broad COPY busts the layer cache. Only what the Dockerfiles read gets in.
# https://docs.docker.com/go/build-context-dockerignore/

*

# Dockerfile.backend
!pyproject.toml
!uv.lock
!backend/pyproject.toml
!backend/README.md
!backend/alembic.ini
!backend/app
!backend/migrations
!shared/pyproject.toml
!shared/README.md
!shared/shared

# Dockerfile.frontend-svelte
!frontend-svelte/ui

# Re-excluded inside the allowed folders (rules below win over the ones above).
**/__pycache__
**/*.pyc
**/.env
**/.env.*
frontend-svelte/ui/node_modules
frontend-svelte/ui/.svelte-kit
frontend-svelte/ui/build
frontend-svelte/ui/dist
frontend-svelte/ui/test-results
frontend-svelte/ui/playwright-report
frontend-svelte/ui/e2e
frontend-svelte/ui/static/pdfjs
frontend-svelte/ui/src/lib/paraglide
frontend-svelte/ui/project.inlang/cache
frontend-svelte/ui/vite.config.ts.timestamp-*
