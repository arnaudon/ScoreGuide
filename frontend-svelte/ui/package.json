{
	"name": "ui",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"type": "module",
	"dependencies": {
		"@sentry/sveltekit": "^11.15.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource/eb-garamond": "^5.3.0",
		"@fontsource/figtree": "^5.3.0",
		"@inlang/paraglide-js": "^3.2.2",
		"@inlang/plugin-m-function-matcher": "^2.4.3",
		"@inlang/plugin-message-format": "^4.6.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.76.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/svelte-table": "^9.3.1",
		"@types/node": "^26.6.6",
		"@vitest/browser-playwright": "^5.1.1",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"lucide-svelte": "^1.0.1",
		"mode-watcher": "^1.1.0",
		"pdfjs-dist": "^6.5.438",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.1.18",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"vitest-browser-svelte": "^3.1.0"
	},
	"keywords": [
		"svelte"
	],
	"overrides": {
		"svelte-eslint-parser": {
			"postcss-selector-parser": "^7.1.6"
		},
		"runed": {
			"@sveltejs/kit": "^3.1.1"
		},
		"@tailwindcss/typography": {
			"postcss-selector-parser": "^6.1.5"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
